{
  "name": "subtensor-evm-setup",
  "version": "1.0.0",
  "description": "Scripts for demonstration of EVM functionality on Subtensor",
  "scripts": {
    "build": "npx hardhat compile",
    "deploy-local": "npx hardhat run scripts/deploy.ts --network local",
    "deploy-stake-testnet": "npx hardhat run scripts/deploy-stake.ts --network subevm",
    "deploy-transfer-testnet": "npx hardhat run scripts/deploy-transfer.ts --network subevm",
    "deploy-subnet-testnet": "npx hardhat run scripts/deploy-subnet.ts --network subevm",
    "test": "REPORT_GAS=true npx hardhat test --network hardhat",
    "balance-local": "npx hardhat run scripts/get-balance.ts --network local",
    "balance-testnet": "npx hardhat run scripts/get-balance.ts --network subevm"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.0.0",
    "@babel/runtime": "^7.25.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.4.0",
    "@typechain/hardhat": "^8.0.0",
    "@polkadot/api": "^12.3.1",
    "@polkadot/keyring": "12.2.1",
    "@polkadot/util": "^13.0.2",
    "@polkadot/util-crypto": "^13.0.2",
    "bignumber": "1.1.0",
    "ethers": "6.13.2",
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.4",
    "chai": "^4.2.0",
    "fs": "^0.0.1-security",
    "hardhat": "^2.19.4",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  }
}
